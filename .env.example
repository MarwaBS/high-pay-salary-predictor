# ── .env.example ─────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# The .env file is git-ignored and should NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   # edit .env
#   docker compose --env-file .env up
# ─────────────────────────────────────────────────────────────────────────────

# ── API CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware.
# Default: empty (rejects cross-origin requests). Set to "*" for local dev.
#
# Development:
CORS_ORIGINS=*
#
# Production example:
# CORS_ORIGINS=https://myapp.com,https://staging.myapp.com

# ── API Authentication ───────────────────────────────────────────────────────
# If set, all /predict requests require an X-API-Key header.
# Unset = dev mode (no auth required).
# API_KEY=your-secret-key-here
# Failed auth attempts allowed per IP inside the window (default: 10).
AUTH_FAILURE_LIMIT=10
# Length of that sliding window, in seconds (default: 60).
AUTH_FAILURE_WINDOW_S=60

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Per-IP rate limit for the /predict endpoint.
# Format: "N/period" where period is second, minute, hour, or day.
RATE_LIMIT=60/minute
# Number of your own reverse proxies in front of the API. The client IP is
# read that many entries from the right of X-Forwarded-For; 0 = no proxy,
# use the direct peer address (default: 0).
TRUSTED_PROXY_HOPS=0

# ── Request Size Limit ───────────────────────────────────────────────────────
# Requests with a body larger than this are rejected with 413.
# Default: 524288 (512 KiB).
MAX_BODY_BYTES=524288

# ── Prediction Cache (Redis) ─────────────────────────────────────────────────
# Optional. If set, /predict caches deterministic results in Redis and
# short-circuits repeated identical requests. Leave unset for a silent
# no-op cache (zero runtime impact, zero dependencies at runtime).
# docker-compose.yml wires this to the bundled redis service.
REDIS_URL=redis://redis:6379/0
# Cache TTL in seconds (default: 3600 = 1 hour).
CACHE_TTL=3600

# ── Service Ports ─────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
API_PORT=8000
